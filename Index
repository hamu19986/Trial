<html class="scroll-smooth" lang="en">
 <head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1" name="viewport"/>
  <title>
   AI Research Tool
  </title>
  <script src="https://cdn.tailwindcss.com">
  </script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;display=swap" rel="stylesheet"/>
  <style>
   body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      color: #e0e7ff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      background: rgba(15, 32, 39, 0.85);
      backdrop-filter: saturate(180%) blur(20px);
      box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
      border-bottom: 1px solid #0ff;
      z-index: 50;
    }
    h1, h2, h3 {
      text-shadow:
        0 0 5px #0ff,
        0 0 10px #0ff,
        0 0 20px #0ff,
        0 0 40px #0ff;
    }
    button {
      box-shadow:
        0 0 8px #0ff,
        0 0 20px #0ff;
      transition: box-shadow 0.3s ease;
      transform-style: preserve-3d;
      perspective: 1000px;
    }
    button:hover, button:focus {
      box-shadow:
        0 0 15px #0ff,
        0 0 40px #0ff,
        0 0 60px #0ff;
      transform: translateZ(10px);
      outline: none;
    }
    #resultsContainer {
      background: rgba(10, 25, 35, 0.85);
      border-radius: 1rem;
      box-shadow:
        inset 0 0 20px #0ff,
        0 0 30px #0ff;
      color: #d0e8ff;
      font-weight: 500;
    }
    textarea {
      background: rgba(10, 25, 35, 0.85);
      border: 1.5px solid #0ff;
      color: #d0e8ff;
      box-shadow:
        0 0 10px #0ff inset;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    textarea:focus {
      border-color: #0ff;
      box-shadow:
        0 0 20px #0ff inset;
      outline: none;
    }
    label {
      text-shadow:
        0 0 5px #0ff;
    }
    /* 3D floating animation for the logo */
    @keyframes float3d {
      0%, 100% {
        transform: translateZ(0) translateY(0);
        filter: drop-shadow(0 0 5px #0ff);
      }
      50% {
        transform: translateZ(20px) translateY(-8px);
        filter: drop-shadow(0 0 15px #0ff);
      }
    }
    .logo-3d {
      animation: float3d 4s ease-in-out infinite;
      filter: drop-shadow(0 0 10px #0ff);
      border-radius: 0.5rem;
      box-shadow:
        0 0 15px #0ff,
        0 0 30px #0ff inset;
      transform-style: preserve-3d;
      perspective: 1000px;
    }
    /* Scrollbar styling for results container */
    #resultsContainer::-webkit-scrollbar {
      width: 8px;
    }
    #resultsContainer::-webkit-scrollbar-track {
      background: rgba(15, 32, 39, 0.5);
      border-radius: 4px;
    }
    #resultsContainer::-webkit-scrollbar-thumb {
      background: #0ff;
      border-radius: 4px;
    }
    /* Loading spinner with neon glow */
    #loadingSection svg {
      filter: drop-shadow(0 0 10px #0ff);
    }
    /* Button icon glow */
    button i {
      text-shadow:
        0 0 5px #0ff,
        0 0 10px #0ff;
    }
  </style>
 </head>
 <body>
  <header class="sticky top-0">
   <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <div class="flex items-center space-x-3">
     <img alt="3D floating logo with letters AI in glowing blue on dark background" class="w-12 h-12 logo-3d" height="80" src="https://storage.googleapis.com/a1aa/image/2f8ab05a-2f42-48b6-9a8c-c53ff5e3121d.jpg" width="80"/>
     <h1 class="text-3xl font-extrabold text-indigo-400 tracking-wide select-none">
      AI Research Tool
     </h1>
    </div>
   </div>
  </header>
  <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
   <section>
    <form autocomplete="off" class="mb-8" id="researchForm" spellcheck="false">
     <label class="block text-lg font-semibold mb-3" for="query">
      Enter your research topic or query
     </label>
     <textarea aria-label="Research query input" autocapitalize="off" autocorrect="off" class="w-full rounded-lg p-4 text-lg leading-relaxed placeholder-indigo-300" id="query" name="query" placeholder="Type your research topic here..." required="" rows="4" spellcheck="false"></textarea>
     <button aria-label="Start research" class="mt-6 inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-cyan-400 to-blue-600 px-8 py-4 text-white font-bold tracking-wide shadow-lg hover:from-cyan-500 hover:to-blue-700 focus:outline-none focus:ring-4 focus:ring-cyan-400 focus:ring-opacity-75 transition-transform active:scale-95" type="submit">
      <i class="fas fa-rocket mr-3 text-xl">
      </i>
      Start Research
     </button>
    </form>
   </section>
   <section aria-atomic="true" aria-live="polite" class="hidden" id="resultsSection">
    <h2 class="text-2xl font-bold mb-5 flex items-center select-none">
     <i class="fas fa-file-alt mr-3 text-cyan-400">
     </i>
     Research Results
    </h2>
    <div aria-label="Research results container" class="max-h-[60vh] overflow-y-auto prose prose-indigo prose-lg" id="resultsContainer" role="region" tabindex="0">
    </div>
    <div class="mt-8 flex flex-col sm:flex-row sm:space-x-6 space-y-4 sm:space-y-0 justify-center">
     <button aria-label="Download results as PDF" class="flex items-center justify-center rounded-lg bg-gradient-to-r from-green-500 to-green-700 px-6 py-3 text-white font-semibold shadow-lg hover:from-green-600 hover:to-green-800 focus:outline-none focus:ring-4 focus:ring-green-400 focus:ring-opacity-75 transition-transform active:scale-95" id="downloadPdfBtn" type="button">
      <i class="fas fa-file-pdf mr-2 text-lg">
      </i>
      Download PDF
     </button>
     <button aria-label="Download results as TXT" class="flex items-center justify-center rounded-lg bg-gradient-to-r from-blue-500 to-blue-700 px-6 py-3 text-white font-semibold shadow-lg hover:from-blue-600 hover:to-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-400 focus:ring-opacity-75 transition-transform active:scale-95" id="downloadTxtBtn" type="button">
      <i class="fas fa-file-alt mr-2 text-lg">
      </i>
      Download TXT
     </button>
     <button aria-label="Copy results to clipboard" class="flex items-center justify-center rounded-lg bg-gradient-to-r from-indigo-500 to-indigo-700 px-6 py-3 text-white font-semibold shadow-lg hover:from-indigo-600 hover:to-indigo-800 focus:outline-none focus:ring-4 focus:ring-indigo-400 focus:ring-opacity-75 transition-transform active:scale-95" id="copyBtn" type="button">
      <i class="fas fa-copy mr-2 text-lg">
      </i>
      Copy to Clipboard
     </button>
    </div>
   </section>
   <section aria-busy="true" aria-live="assertive" class="hidden mt-12 flex flex-col items-center space-y-6" id="loadingSection" role="alert">
    <svg aria-hidden="true" class="animate-spin h-14 w-14 text-cyan-400" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
     <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
     </circle>
     <path class="opacity-75" d="M4 12a8 8 0 018-8v8H4z" fill="currentColor">
     </path>
    </svg>
    <p class="text-cyan-400 font-semibold text-xl select-none tracking-wide">
     Performing in-depth AI research...
    </p>
   </section>
  </main>
  <footer class="bg-transparent border-t border-cyan-600 py-6 mt-16 text-center text-cyan-400 text-sm select-none">
   © 2024 AI Research Tool. All rights reserved.
  </footer>
  <script>
   // Simulated async function to mimic querying multiple AI models and sources
    async function fetchFromModel(modelName, query) {
      // Simulate variable response times and results
      const delay = (ms) => new Promise((res) => setTimeout(res, ms));
      const simulatedDelays = {
        'Gemini Deep Research': 1800,
        'ChatGPT': 1500,
        'Meta AI': 1700,
        'Claude AI': 1600,
        'Grok AI': 1400,
        'DeepSeek-V3': 1300,
        'Claude-Sonnet-3.7': 1900,
        'GPT-4o': 2000,
        'o3-mini': 1200,
        'DeepSeek-R1': 1100,
        'Llama-4-Maverick-17B-128E': 2100,
      };
      await delay(simulatedDelays[modelName] || 1500);

      // Simulated research snippet for each model
      const snippets = {
        'Gemini Deep Research': `Gemini Deep Research found that "${query}" has significant implications in emerging AI technologies, focusing on multi-modal data integration and advanced reasoning.`,
        'ChatGPT': `ChatGPT highlights that "${query}" is a trending topic with numerous applications in natural language processing and conversational AI.`,
        'Meta AI': `Meta AI's analysis suggests that "${query}" is pivotal in advancing social AI systems and ethical AI deployment.`,
        'Claude AI': `Claude AI emphasizes the importance of "${query}" in enhancing AI safety and interpretability.`,
        'Grok AI': `Grok AI's insights reveal that "${query}" is crucial for real-time AI decision-making and adaptive learning.`,
        'DeepSeek-V3': `DeepSeek-V3 uncovers that "${query}" is widely researched in the context of deep learning optimization and neural architecture search.`,
        'Claude-Sonnet-3.7': `Claude-Sonnet-3.7 provides poetic and creative perspectives on "${query}", linking it to AI creativity and generative art.`,
        'GPT-4o': `GPT-4o delivers a comprehensive overview of "${query}", including recent breakthroughs and future research directions.`,
        'o3-mini': `o3-mini offers a concise summary of "${query}" with focus on lightweight AI models and edge computing.`,
        'DeepSeek-R1': `DeepSeek-R1 highlights the role of "${query}" in reinforcement learning and autonomous systems.`,
        'Llama-4-Maverick-17B-128E': `Llama-4-Maverick-17B-128E provides an in-depth technical analysis of "${query}" with emphasis on large-scale model training and efficiency.`,
      };

      return {
        model: modelName,
        content: snippets[modelName] || `No data available for ${modelName}.`,
      };
    }

    // Combine and arrange results in a managed manner
    function combineResults(results) {
      // Sort results by model name alphabetically for consistency
      results.sort((a, b) => a.model.localeCompare(b.model));

      // Create a structured HTML string with headings and paragraphs
      let combinedHTML = '';
      results.forEach(({ model, content }) => {
        combinedHTML += `<h3 class="text-cyan-400 font-semibold mt-6">${model}</h3>`;
        combinedHTML += `<p class="mt-2 text-gray-200">${content}</p>`;
      });

      return combinedHTML;
    }

    // Convert HTML content to plain text for TXT download
    function htmlToPlainText(html) {
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = html;
      return tempDiv.textContent || tempDiv.innerText || '';
    }

    // Generate PDF from HTML content using jsPDF and html2canvas
    async function generatePDF(htmlContent, title) {
      // Load jsPDF and html2canvas dynamically
      if (!window.jspdf) {
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');
      }
      if (!window.html2canvas) {
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js');
      }

      const { jsPDF } = window.jspdf;

      // Create a container to render the content for canvas
      const container = document.createElement('div');
      container.style.width = '600px';
      container.style.padding = '20px';
      container.style.background = '#0a1923';
      container.style.color = '#d0e8ff';
      container.style.fontFamily = "'Inter', sans-serif";
      container.style.fontSize = '14px';
      container.style.lineHeight = '1.5';
      container.style.borderRadius = '12px';
      container.innerHTML = htmlContent;
      document.body.appendChild(container);

      // Use html2canvas to render container to canvas
      const canvas = await window.html2canvas(container, {
        scale: 2,
        backgroundColor: '#0a1923',
        useCORS: true,
        scrollY: -window.scrollY,
      });

      document.body.removeChild(container);

      const imgData = canvas.toDataURL('image/png');
      const pdf = new jsPDF({
        unit: 'pt',
        format: 'a4',
      });

      const pdfWidth = pdf.internal.pageSize.getWidth();
      const pdfHeight = (canvas.height * pdfWidth) / canvas.width;

      pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
      pdf.save(`${title.replace(/\s+/g, '_')}_Research.pdf`);
    }

    // Dynamically load external scripts
    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    // Download text file helper
    function downloadTextFile(filename, text) {
      const blob = new Blob([text], { type: 'text/plain' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Copy text to clipboard helper
    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        alert('Results copied to clipboard!');
      } catch (err) {
        alert('Failed to copy results. Please copy manually.');
      }
    }

    // Main form submit handler
    document.getElementById('researchForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = e.target.query.value.trim();
      if (!query) return;

      // UI toggles
      document.getElementById('resultsSection').classList.add('hidden');
      document.getElementById('loadingSection').classList.remove('hidden');

      // List of AI models/sources to query
      const models = [
        'Gemini Deep Research',
        'ChatGPT',
        'Meta AI',
        'Claude AI',
        'Grok AI',
        'DeepSeek-V3',
        'Claude-Sonnet-3.7',
        'GPT-4o',
        'o3-mini',
        'DeepSeek-R1',
        'Llama-4-Maverick-17B-128E',
      ];

      // Perform all queries concurrently to optimize time
      const promises = models.map((model) => fetchFromModel(model, query));
      let results = [];
      try {
        results = await Promise.all(promises);
      } catch (error) {
        alert('An error occurred while fetching research data. Please try again.');
        document.getElementById('loadingSection').classList.add('hidden');
        return;
      }

      // Combine and arrange results
      const combinedHTML = combineResults(results);

      // Show results
      const resultsContainer = document.getElementById('resultsContainer');
      resultsContainer.innerHTML = combinedHTML;

      document.getElementById('loadingSection').classList.add('hidden');
      document.getElementById('resultsSection').classList.remove('hidden');
      resultsContainer.focus();
    });

    // Download PDF button handler
    document.getElementById('downloadPdfBtn').addEventListener('click', async () => {
      const resultsContainer = document.getElementById('resultsContainer');
      if (!resultsContainer.innerHTML.trim()) {
        alert('No results to download.');
        return;
      }
      const title = document.getElementById('query').value.trim() || 'Research';
      try {
        await generatePDF(resultsContainer.innerHTML, title);
      } catch (e) {
        alert('Failed to generate PDF. Please try again.');
      }
    });

    // Download TXT button handler
    document.getElementById('downloadTxtBtn').addEventListener('click', () => {
      const resultsContainer = document.getElementById('resultsContainer');
      if (!resultsContainer.innerHTML.trim()) {
        alert('No results to download.');
        return;
      }
      const plainText = htmlToPlainText(resultsContainer.innerHTML);
      const title = document.getElementById('query').value.trim() || 'Research';
      downloadTextFile(`${title.replace(/\s+/g, '_')}_Research.txt`, plainText);
    });

    // Copy to clipboard button handler
    document.getElementById('copyBtn').addEventListener('click', () => {
      const resultsContainer = document.getElementById('resultsContainer');
      if (!resultsContainer.innerHTML.trim()) {
        alert('No results to copy.');
        return;
      }
      const plainText = htmlToPlainText(resultsContainer.innerHTML);
      copyToClipboard(plainText);
    });
  </script>
 </body>
</html>
